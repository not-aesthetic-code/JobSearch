DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/jobsearch
API_KEY=
OPENAI_API_KEY=
# optional: any OpenAI-compatible endpoint (OpenRouter, Ollama, Groq...); empty = api.openai.com
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Gmail job-alert ingest (app password, needs 2FA on the account)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SENDERS=jobs-noreply@linkedin.com,noreply@pracuj.pl
# trash = move mail to [Gmail]/Trash after its postings are stored (30-day recovery); keep = mark read only
GMAIL_AFTER_INGEST=trash
